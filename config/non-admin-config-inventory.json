{
  "environment_config": [
    {
      "key": "server_host",
      "owner": "platform",
      "unit": "url_or_host",
      "consumers": ["mobile"],
      "apply_mode": "build_time",
      "sensitive": false,
      "description": "Flutter SERVER_HOST dart-define or deployment host"
    },
    {
      "key": "database_connection",
      "owner": "platform",
      "unit": "connection_settings",
      "consumers": ["auth-service", "wallet-service", "game-engine"],
      "apply_mode": "restart",
      "sensitive": true,
      "description": "DB_HOST, DB_PORT, DB_NAME, DB_USER and DB_PASSWORD stay in environment or secret manager"
    },
    {
      "key": "jwt_secret",
      "owner": "security",
      "unit": "secret",
      "consumers": ["auth-service", "wallet-service", "game-engine"],
      "apply_mode": "restart",
      "sensitive": true,
      "description": "JWT signing secret stays in environment or secret manager"
    },
    {
      "key": "cors_origins",
      "owner": "platform",
      "unit": "origin_list",
      "consumers": ["auth-service", "wallet-service", "game-engine"],
      "apply_mode": "restart",
      "sensitive": false,
      "description": "Allowed CORS origins are deployment configuration, not admin free-text"
    },
    {
      "key": "service_ports",
      "owner": "platform",
      "unit": "ports",
      "consumers": ["auth-service", "wallet-service", "game-engine"],
      "apply_mode": "restart",
      "sensitive": false,
      "description": "PORT for each service"
    },
    {
      "key": "public_app_url",
      "owner": "platform",
      "unit": "url",
      "consumers": ["wallet-service", "agent-portal"],
      "apply_mode": "restart",
      "sensitive": false,
      "description": "PUBLIC_APP_URL used for public referral links"
    },
    {
      "key": "config_listen_retry_ms",
      "owner": "platform",
      "unit": "milliseconds",
      "consumers": ["auth-service", "wallet-service", "game-engine"],
      "apply_mode": "restart",
      "sensitive": false,
      "description": "PostgreSQL LISTEN reconnect retry delay"
    },
    {
      "key": "app_version",
      "owner": "mobile",
      "unit": "semver",
      "consumers": ["mobile"],
      "apply_mode": "build_time",
      "sensitive": false,
      "description": "Flutter application build version used for minimum-version checks"
    },
    {
      "key": "use_production",
      "owner": "mobile",
      "unit": "flag",
      "consumers": ["mobile"],
      "apply_mode": "build_time",
      "sensitive": false,
      "description": "Flutter production/local endpoint selector"
    },
    {
      "key": "enable_logging",
      "owner": "mobile",
      "unit": "flag",
      "consumers": ["mobile"],
      "apply_mode": "build_time",
      "sensitive": false,
      "description": "Flutter debug logging selector"
    },
    {
      "key": "app_timeout_environment_defaults",
      "owner": "platform",
      "unit": "seconds",
      "consumers": ["mobile"],
      "apply_mode": "build_time",
      "sensitive": false,
      "description": "APP_HTTP_TIMEOUT_SECONDS and APP_HEALTH_CHECK_TIMEOUT_SECONDS are temporary environment defaults until server runtime config is loaded"
    }
  ],
  "protocol_invariant": [
    {
      "key": "standard_deck",
      "owner": "game_engine",
      "unit": "cards",
      "consumers": ["game-engine"],
      "apply_mode": "deployment",
      "description": "Standard 52-card deck and card ranks/suits"
    },
    {
      "key": "chinese_poker_hand_size",
      "owner": "game_engine",
      "unit": "cards",
      "consumers": ["game-engine", "mobile"],
      "apply_mode": "deployment",
      "description": "Chinese Poker 13-card protocol and row sizes"
    }
  ],
  "security_invariant": [
    {
      "key": "authenticated_session_record",
      "owner": "security",
      "unit": "control",
      "consumers": ["auth-service", "wallet-service", "game-engine"],
      "apply_mode": "deployment",
      "description": "JWT must be bound to a non-revoked persisted session; this is not an Admin-editable policy"
    },
    {
      "key": "admin_privilege_boundaries",
      "owner": "security",
      "unit": "control",
      "consumers": ["wallet-service", "admin-web"],
      "apply_mode": "deployment",
      "description": "Only authorized administrator roles can mutate privileged resources; not configurable through runtime policy"
    },
    {
      "key": "password_hashing_required",
      "owner": "security",
      "unit": "control",
      "consumers": ["auth-service", "wallet-service"],
      "apply_mode": "deployment",
      "description": "Passwords must be stored only as bcrypt hashes; the hash algorithm is a security invariant while rounds are configured"
    }
  ],
  "client_presentation_config": [
    {
      "key": "ui_animation_durations",
      "owner": "frontend",
      "unit": "milliseconds",
      "consumers": ["mobile"],
      "apply_mode": "app_release",
      "description": "Pure visual animation timing that does not control server authority"
    },
    {
      "key": "room_city_flag_map",
      "owner": "frontend",
      "unit": "lookup_table",
      "consumers": ["mobile"],
      "apply_mode": "app_release",
      "description": "Presentation-only room-name to flag lookup; does not affect game or business policy"
    }
  ]
}
